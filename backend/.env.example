# 앱 DB, 수집 DB (postgresql+psycopg://...)
# 로컬 수집 DB는 docker-compose.yml: postgresql+psycopg://saitgil:<비밀번호>@127.0.0.1:5433/saitgil
# 배포는 Neon pooler 주소(postgresql://...?sslmode=require)를 Render·Actions 에 넣는다.
DATABASE_URL=
COLLECTOR_DATABASE_URL=
COLLECTOR_CONNECT_TIMEOUT_S=
# 길찾기 중 수집 DB 접속 대기(초)
ROUTE_DB_CONNECT_TIMEOUT_S=
# 수집기: S-DoT 겹쳐 받는 시간(분)·최대 쪽 수·DB가 비었을 때 받는 행 수,
# 날씨 실황 메우는 시간(시간)·단기예보 발표 시(時)·받는 시간(시간)·자치구 위치 기간(일)
COLLECTOR_SDOT_OVERLAP_MINUTES=
COLLECTOR_SDOT_MAX_PAGES=
COLLECTOR_SDOT_ROWS=
COLLECTOR_BACKFILL_HOURS=
COLLECTOR_DAILY_ISSUE_HOUR=
COLLECTOR_DAILY_HOURS=
COLLECTOR_DISTRICT_DAYS=

# CORS·도메인 (ALLOWED_ORIGINS 는 JSON 목록)
# 비우면 앱 Origin("https://localhost"·"capacitor://localhost")만 허용한다.
# 웹은 /api 를 같은 주소로 넘겨 받아 CORS 가 필요 없다.
# 값을 직접 지정하면 기본 목록을 덮어쓰므로 앱 Origin 도 함께 넣는다.
FRONTEND_URL=
ALLOWED_ORIGINS=

# 경로 점수 데이터 위치 (비우면 data/processed/ 아래 기본 파일)
DEM_PATH=
SENSORS_PATH=
CITYDATA_AREAS_PATH=

# 경로 점수 기준 (비우면 app/config.py 기본값)
ROUTE_SAMPLE_INTERVAL_M=
CONGESTION_RADIUS_M=
CONGESTION_FULL_COUNT=
CROWDED_LEVEL=
# 도시데이터 혼잡 단계별 혼잡도(JSON 목록, 여유·보통·약간 붐빔·붐빔), 최신 수집분 유효 시간(시간),
# 지금 시각과 맞추는 범위(분), DB 값 캐시 시간(초)
CITYDATA_LEVEL_VALUES=
CITYDATA_MAX_AGE_H=
CITYDATA_MATCH_WINDOW_MINUTES=
CITYDATA_CACHE_TTL_S=
# 걷는 속도(m/s, 경로 걷는 시간·점마다 도착 시각 계산), 예측 유동인구를 10분 값으로 나누는 수, 예측 캐시 시간(초)
WALKING_SPEED_MPS=
FORECAST_BINS_PER_HOUR=
FORECAST_CACHE_TTL_S=
SLOPE_MODERATE_WEIGHT=
SLOPE_HARD_WEIGHT=
ROUTE_CONGESTION_MARGIN_M=
ROUTE_SLOPE_MARGIN_M=
