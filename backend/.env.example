# S-DoT 실시간 주소·요청 제한 시간(초)·받을 행 수·캐시 시간(초)·측정값 유효 시간(분) (비우면 기본값)
SDOT_BASE_URL=
SDOT_TIMEOUT_S=
SDOT_PAGE_SIZE=
SDOT_CACHE_TTL_S=
SDOT_MAX_AGE_MINUTES=
# 서울 실시간 인구데이터 주소·요청 제한 시간(초)·수집 동시 요청 수 (비우면 기본값)
