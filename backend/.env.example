# Tmap 경로·POI
TMAP_APP_KEY=
# Tmap API 주소·요청 제한 시간(초)·경로 검색 옵션(JSON 목록)·장소 검색 결과 수 (비우면 기본값)
TMAP_BASE_URL=
TMAP_TIMEOUT_S=
TMAP_SEARCH_OPTIONS=
PLACE_SEARCH_COUNT=
# 서울 실시간 도시데이터, S-DoT, 문화행사 정보
