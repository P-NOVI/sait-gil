# 백엔드 주소. 웹은 비우면 같은 도메인의 /api 를 쓰고, 앱 빌드에는 반드시 절대 주소를 넣는다
# Android 는 .env.android.example 을 .env.android 로 복사해서 설정한다.
# 웹에 http://localhost:8000 같은 절대 주소를 넣으면 백엔드 CORS 에 막힌다. 로컬 백엔드는 API_PROXY_TARGET 으로 바꾼다.
VITE_API_BASE_URL=
# Tmap 지도 JavaScript 키 (빌드 결과에 들어가 브라우저에 보이는 키). 비우면 지도 없이 쓴다
VITE_TMAP_APP_KEY=
# true 면 카메라 플러그인 없이 정해진 인파 단계를 차례로 흘려 안내 중 인파 알림을 확인한다
VITE_VISION_MOCK=
# npm run dev 가 /api 요청을 넘길 백엔드 주소. 비우면 http://127.0.0.1:8000
API_PROXY_TARGET=
