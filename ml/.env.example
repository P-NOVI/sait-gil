# 데이터 폴더(이력·날씨·달력·모델). 비우면 저장소의 data/ 를 쓴다.
DATA_DIR=
# 수집 DB 접속 주소(foot_traffic.daily). backend/.env 의 COLLECTOR_DATABASE_URL 과 같은 값이다.
COLLECTOR_DATABASE_URL=
# Neon Object storage(S3 호환) 접속 정보(foot_traffic.storage).
# 콘솔 Connect > Storage 의 엔드포인트, 리전(ap-southeast-1), credential 의 키 두 개다.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
